  "faq": [
    {
      "id": "faq-1",
      "question": "پلتفرم برای چه کسانی است؟",
      "answer": "هم برای شرکت‌های کامل‌خدمت کابینت و هم برای متخصصان و تیم‌های تخصصی که فقط چند ماژول را نیاز دارند.",
      "keywords": [
        "شرکت",
        "متخصص",
        "ماژول",
        "مخاطب"
      ]
    },
    {
      "id": "faq-2",
      "question": "آیا می‌توان فقط ماژول اندازه‌گیری را خرید؟",
      "answer": "بله. خرید ماژول فقط همان قابلیت را فعال می‌کند و به‌تنهایی دسترسی به شرکت‌ها یا پروژه‌های دیگران نمی‌دهد.",
      "keywords": [
        "خرید",
        "ماژول",
        "اندازه‌گیری",
        "پلن"
      ]
    },
    {
      "id": "faq-3",
      "question": "ماژول برنامه‌ریزی چه خروجی‌ای می‌دهد؟",
      "answer": "یک خروجی دیداری سه‌بعدی و یک خروجی ساخت‌یافته شامل ابعاد، مختصات، دیوارها، بازشوها، موانع و اطلاعات تجهیزات.",
      "keywords": [
        "برنامه‌ریزی",
        "خروجی",
        "سه بعدی",
        "داده"
      ]
    },
